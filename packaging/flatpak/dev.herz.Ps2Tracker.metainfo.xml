<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>dev.herz.Ps2Tracker</id>
  <name>PS2 Session Tracker</name>
  <summary>Session stats, overlay and crosshair for PlanetSide 2</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <developer id="dev.herz">
    <name>Maximilian Herz</name>
  </developer>
  <description>
    <p>
      Tracks your PlanetSide 2 sessions live: kills, deaths, K/D, KPM, headshot rate,
      streaks and a comparison with your lifetime stats. Adds an overlay window, a
      pixel-exact crosshair and voice packs (including Recursion packs).
    </p>
    <p>
      All game data comes from the public Daybreak Census API. The tracker never touches
      the game: no injection, no hooks, no memory reading.
    </p>
  </description>
  <launchable type="desktop-id">dev.herz.Ps2Tracker.desktop</launchable>
