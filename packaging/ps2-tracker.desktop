[Desktop Entry]
Type=Application
Name=PS2 Session Tracker
GenericName=Session stats and overlay for PlanetSide 2
Comment=Session stats, overlay, crosshair and voice packs (Census API only, never touches the game)
Exec=ps2-tracker
Icon=ps2-tracker
Terminal=false
Categories=Game;Utility;
StartupWMClass=ps2-tracker
Actions=ToggleOverlay;ToggleEdit;ToggleCrosshair;NextCrosshair;

[Desktop Action ToggleOverlay]
Name=Toggle overlay
Exec=ps2-tracker --toggle-overlay

[Desktop Action ToggleEdit]
Name=Move overlay / lock position
Exec=ps2-tracker --toggle-edit

[Desktop Action ToggleCrosshair]
Name=Toggle crosshair
Exec=ps2-tracker --toggle-crosshair

[Desktop Action NextCrosshair]
Name=Next crosshair
Exec=ps2-tracker --next-crosshair
