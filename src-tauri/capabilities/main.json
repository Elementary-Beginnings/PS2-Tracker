    "allow-crosshair-import",
    "allow-crosshair-toggle",
    "allow-focus-probe",
    "allow-crosshair-fx-preview",
    "allow-import-session",
    "allow-session-analysis",
    "allow-save-png",
    "allow-squad-rows",
    "allow-outfit-members",
    "allow-squad-remove",
    "allow-update-status",
    "allow-update-check",
    "allow-update-install",
    "allow-startup-notices",
    "allow-hotkey-status",
    "allow-service-id-source",
    "allow-class-icons",
    "allow-app-info"
